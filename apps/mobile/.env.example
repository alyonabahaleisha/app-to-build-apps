# Mobile-side configuration. Copy to .env (gitignored) and fill in.
# Keys prefixed EXPO_PUBLIC_ are bundled into the JS — do NOT put service-role secrets here.

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=

# Supabase project URL + anon key. Used by SessionProvider for token refresh
# (refresh-token grant). NEVER put the service-role key here — it's anon only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Auth provider: 'apple' (V0 default) or 'magic-link' (emergency rollback).
# Production EAS builds default to 'apple' (eas.json production profile).
# Local dev defaults to 'magic-link'; set to 'apple' to test the SIWA flow locally.
EXPO_PUBLIC_AUTH_PROVIDER=magic-link

# Build-time only (used by app.config.ts)
IOS_BUNDLE_ID=com.appcreator.mvp
EAS_PROJECT_ID=
