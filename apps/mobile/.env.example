# Mobile-side configuration. Copy to .env (gitignored) and fill in.
# Keys prefixed EXPO_PUBLIC_ are bundled into the JS — do NOT put service-role secrets here.

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=

# Supabase project URL + anon key. Used by SessionProvider for token refresh
# (refresh-token grant). NEVER put the service-role key here — it's anon only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build-time only (used by app.config.ts)
IOS_BUNDLE_ID=com.appcreator.mvp
EAS_PROJECT_ID=
