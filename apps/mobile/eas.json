{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {"simulator": true}
    },
    "preview": {
      "distribution": "internal",
      "ios": {"simulator": false}
    },
    "production": {
      "distribution": "store",
      "ios": {"autoIncrement": "buildNumber"}
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    }
  }
}
