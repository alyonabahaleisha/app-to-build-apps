# Force flat node_modules layout instead of pnpm's symlinked flat-store.
#
# Why: React Native's Metro bundler doesn't reliably resolve transitive deps
# through pnpm's `.pnpm/<pkg>@<ver>/node_modules/<pkg>/` layout. Without this,
# `expo-modules-core` (and similar transitives of the `expo` package) can't
# be found at bundle time, even though `pnpm install` reports success.
#
# Trade-off: bigger node_modules (no symlink dedup), but reliable bundling.
# Standard pattern for pnpm + React Native monorepos.
node-linker=hoisted
