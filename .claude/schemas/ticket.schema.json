{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ticket",
  "description": "Normalized ticket data fetched from Trello/GitHub/manual. Stored at .claude/state/<ticket-id>/ticket.json",
  "type": "object",
  "required": ["id", "title", "description", "source"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Ticket identifier (e.g., CARD-abc123, #42)"
    },
    "title": { "type": "string" },
    "description": {
      "type": "string",
      "description": "Full ticket description/body"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of acceptance criteria extracted from the ticket"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "unknown"]
    },
    "reporter": { "type": "string" },
    "assignee": { "type": "string" },
    "linked_specs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "URLs or references to linked design docs, specs, PRs"
    },
    "source": {
      "type": "string",
      "enum": ["trello", "github", "manual"],
      "description": "Where the ticket was fetched from"
    },
    "source_url": { "type": "string" },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
