{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Plan",
  "description": "Structured plan produced by the architect subagent. Stored at .claude/state/<ticket-id>/plan.json. The files_allowlist is binding — scope guard hooks enforce it during execution.",
  "type": "object",
  "required": ["ticket_id", "files_allowlist", "approach", "steps", "test_strategy", "budget"],
  "properties": {
    "ticket_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "files_allowlist": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Explicit list of file paths the executor may create or modify. Relative to repo root."
    },
    "approach": {
      "type": "string",
      "description": "High-level summary of the implementation approach"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "description": { "type": "string" },
          "files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "test_strategy": {
      "type": "object",
      "required": ["ac_mapping"],
      "properties": {
        "unit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_file": { "type": "string" },
              "test_class": { "type": "string" },
              "test_methods": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "e2e": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_file": { "type": "string" },
              "test_methods": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "smoke_scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "string" } },
              "expected": { "type": "string" }
            }
          }
        },
        "ac_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Maps each AC identifier to test method(s). e.g. { \"AC-1\": [\"ProfileTests#testMetrics\"] }"
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "rollback": { "type": "string" },
    "budget": {
      "type": "object",
      "required": ["max_tool_calls", "max_tokens", "max_retries"],
      "properties": {
        "max_tool_calls": { "type": "integer", "default": 200 },
        "max_tokens": { "type": "integer", "default": 150000 },
        "max_retries": { "type": "integer", "default": 2 }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
