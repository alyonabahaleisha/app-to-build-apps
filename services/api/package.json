    "@fastify/jwt": "^9.0.1",
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
