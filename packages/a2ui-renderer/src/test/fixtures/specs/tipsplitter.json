{
  "views": [
    {
      "id": "tip-splitter",
      "root": {
        "gap": "lg",
        "type": "Container",
        "padding": "md",
        "children": [
          {
            "text": "\u2615 Tip Splitter",
            "type": "Heading",
            "level": 1
          },
          {
            "text": "Enter the bill total, tip percentage, and number of staff to split the tip evenly.",
            "type": "Text",
            "color": "muted"
          },
          {
            "type": "Form",
            "fields": [
              {
                "id": "bill_total",
                "type": "TextInput",
                "label": "Bill Total ($)",
                "placeholder": "e.g. 42.50"
              },
              {
                "id": "tip_percent",
                "max": 100,
                "min": 0,
                "step": 1,
                "type": "Counter",
                "label": "Tip Percentage (%)"
              },
              {
                "id": "num_staff",
                "max": 50,
                "min": 1,
                "step": 1,
                "type": "Counter",
                "label": "Number of Staff"
              },
              {
                "id": "round_up",
                "type": "Toggle",
                "label": "Round up each share to nearest $0.25",
                "defaultValue": false
              }
            ],
            "formId": "tip-form",
            "submitLabel": "Calculate Split",
            "submitAction": {
              "type": "navigate",
              "viewId": "result"
            }
          }
        ],
        "direction": "column"
      }
    },
    {
      "id": "result",
      "root": {
        "gap": "lg",
        "type": "Container",
        "padding": "md",
        "children": [
          {
            "text": "Tip Split Result",
            "type": "Heading",
            "level": 1
          },
          {
            "gap": "sm",
            "type": "Container",
            "padding": "md",
            "children": [
              {
                "text": "Summary",
                "type": "Heading",
                "level": 2
              },
              {
                "type": "List",
                "items": [
                  {
                    "type": "Container",
                    "justify": "between",
                    "children": [
                      {
                        "text": "Bill Total",
                        "type": "Text",
                        "weight": "bold"
                      },
                      {
                        "text": "See entered amount",
                        "type": "Text",
                        "color": "muted"
                      }
                    ],
                    "direction": "row"
                  },
                  {
                    "type": "Container",
                    "justify": "between",
                    "children": [
                      {
                        "text": "Tip Amount",
                        "type": "Text",
                        "weight": "bold"
                      },
                      {
                        "text": "Bill \u00d7 Tip %",
                        "type": "Text",
                        "color": "muted"
                      }
                    ],
                    "direction": "row"
                  },
                  {
                    "type": "Container",
                    "justify": "between",
                    "children": [
                      {
                        "text": "Each Staff Member Gets",
                        "type": "Text",
                        "weight": "bold"
                      },
                      {
                        "text": "Tip \u00f7 Staff Count",
                        "type": "Text",
                        "color": "muted"
                      }
                    ],
                    "direction": "row"
                  }
                ],
                "separator": true
              }
            ],
            "direction": "column"
          },
          {
            "text": "\ud83d\udca1 Tip: Adjust the values and recalculate anytime.",
            "type": "Text",
            "color": "muted"
          },
          {
            "gap": "sm",
            "type": "Container",
            "children": [
              {
                "type": "Button",
                "label": "Recalculate",
                "action": {
                  "type": "navigate",
                  "viewId": "tip-splitter"
                },
                "variant": "primary"
              },
              {
                "type": "Button",
                "label": "Done",
                "action": {
                  "type": "toast",
                  "message": "Tips distributed! Great work, team! \u2615"
                },
                "variant": "secondary"
              }
            ],
            "direction": "row"
          }
        ],
        "direction": "column"
      }
    }
  ],
  "version": 1,
  "initialState": {
    "round_up": false,
    "num_staff": 2,
    "bill_total": "",
    "tip_percent": 18
  },
  "initialViewId": "tip-splitter"
}
